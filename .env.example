# --- Database ---
DATABASE_URL=file:../db/custom.db

# --- x402 protocol on Stellar ---
# "live" = real on-chain payments (default) | "demo" = simulated flow for offline demos
X402_MODE=live
# CAIP-2 network: stellar:testnet (default) | stellar:pubnet (requires custom RPC)
X402_NETWORK=stellar:testnet
# Price per request (USD, settled in USDC)
X402_PRICE=$0.01
# Coinbase x402 facilitator (supports stellar:testnet with sponsored fees)
X402_FACILITATOR_URL=https://www.x402.org/facilitator
# Service wallet that receives USDC payments (Stellar G... address)
X402_PAY_TO=GBXQJT5DQCIW2BIX4JHTJXPIAOFUZMCLZVRNQY3A5QXCZQDWZEMSHYVL
